---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="404 — Page introuvable | Libeccio" description="Page introuvable.">
  <main class="grid min-h-screen place-items-center px-5 text-center">
    <div>
      <p class="text-7xl font-bold text-primary">404</p>
      <h1 class="mt-4 text-2xl font-semibold">Page introuvable</h1>
      <p class="mt-3 text-muted-foreground">La page demandée n'existe pas ou a été déplacée.</p>
      <a href="/" class="mt-7 inline-flex rounded-full bg-[image:var(--gradient-primary)] px-6 py-3 font-semibold text-primary-foreground">Retour à l'accueil</a>
    </div>
  </main>
</BaseLayout>
